// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EUserRole {
  ADMIN
  SUPERADMIN
  MANAGER
  USER
}

enum EPermission {
  USERS
  COURSES
  TEAMS
  ALUMNI
  PLANNER_COURSE
  NEWS
  ALMUNI_FORM
  JOURNALS
  EDITORIAL_BOARD
  CONNECT
  GALLERY
  SCHOLARSHIP
  NOTICE
  CONTACT
  HOLIDAY
  RECOGNITION
  ACHIEVEMENT

  INTAKE
  DOCUMENTS

  ACADEMIC_PLANNER
  FEE_PLANNER
  DOWNLOADS
}

enum EShift {
  MORNING
  EVENING
  BOTH
}

enum EDepartment {
  MANAGEMENT
  ADMINISTRATION
  COMPUTING
}

enum EIntakeStatus {
  OPEN
  CLOSED
}

enum EStatus {
  ENABLED
  DISABLED
}

enum BlockType {
  HEADING
  SUBHEADING
  PARAGRAPH
  LIST
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  EPermission      @unique
  users UserPermission[]
}

model UserPermission {
  id           Int @id @default(autoincrement())
  userId       Int
  permissionId Int

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model User {
  id       Int       @id @default(autoincrement())
  fullname String
  username String    @unique
  email    String
  role     EUserRole
  password String

  permissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@fulltext([fullname, username])
}
enum EHOLIDAYTYPE {
  ACADEMIC
  ADMINISTRATIVE
}
model Course {
  id        Int                 @id @default(autoincrement())
  title     String              @unique
  shift     EShift
  order     Int?
  duration  String?
  category  String?
  fullForm  String?
  details   String?             @db.VarChar(500)
  prefix    String?
  degree    String?
  semester  String?
  intake    String?
  brochure  String?
  credit    String
  image     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  blocks    CourseDetailBlock[]

  @@fulltext([title, category])
}
model CourseDetailBlock {
  id       Int    @id @default(autoincrement())
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId Int

  parentId Int?
  parent   CourseDetailBlock?  @relation("BlockHierarchy", fields: [parentId], references: [id])
  children CourseDetailBlock[] @relation("BlockHierarchy")

  title   String?
  content String?   @db.VarChar(10000)
  type    BlockType

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id            Int      @id @default(autoincrement())
  image         String?
  title         String
  publishedOn   String?
  publishedOnBS String?
  link          String   @unique
  source        String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Alumni {
  id        Int      @id @default(autoincrement())
  name      String
  batch     String
  link      String?
  position  String?
  course    String
  story     String?  @db.VarChar(1000)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@fulltext([name, course])
}
enum ETYPE {
  RECOGNITION
  PERMISSION
}
model Recognition {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  type        ETYPE?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model OurTeam {
  id         Int         @id @default(autoincrement())
  name       String
  position   String
  department EDepartment
  bio        String?     @db.VarChar(1000)
  image      String?
  portrait   String?
  facebook   String?
  order      Int?
  insta      String?
  phone      String?
  email      String?
  linkedIn   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@fulltext([name, position])
}

enum EHonoraryPosition {
  CHIEF_PATRON
  PATRON
  EDITOR_IN_CHIEF
  ASSOCIATE_EDITOR
  MANAGING_EDITOR
  EDITORIAL_BOARD_MEMBER
  ADVISOR
}

model EditorialBoard {
  id               Int               @id @default(autoincrement())
  name             String
  designation      String
  honoraryPosition EHonoraryPosition
  department       String
  institution      String
  country          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@fulltext([name, designation, institution])
}

model holiday {
  id        Int          @id @default(autoincrement())
  image     String
  type      EHOLIDAYTYPE @unique @default(ADMINISTRATIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model downloads {
  id        Int      @id @default(autoincrement())
  file      String?
  link  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@fulltext([name])
}

model contact {
  id         Int      @id @default(autoincrement())
  purpose    String
  name       String
  department String
  email      String   @unique
  status     EStatus  @default(ENABLED)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@fulltext([name, email, department, purpose])
}

model achievement {
  id         Int      @id @default(autoincrement())
  achivement String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model notice {
  id           Int          @id @default(autoincrement())
  program_name String
  date         String
  title        String
  file         String?
  type         EHOLIDAYTYPE
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AdmissionIntake {
  id        Int           @id @default(autoincrement())
  status    EIntakeStatus
  intake    String
  duration  String
  lastdate  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum PlannerType {
  PARENT
  CHILD
}

model PlannerCourse {
  id   Int    @id @default(autoincrement())
  name String @unique

  academicYears AcademicPlanner[]
  feeYears      FeePlanner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id      Int    @id @default(autoincrement())
  year    String
  session String

  planners AcademicPlanner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicPlanner {
  id              Int     @id @default(autoincrement())
  semester        String
  intake          String
  file            String?
  academicYearId  Int
  plannerCourseId Int?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  plannerCourse PlannerCourse? @relation(fields: [plannerCourseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeYear {
  id      Int     @id @default(autoincrement())
  year    String
  session String?

  feePlanners FeePlanner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeePlanner {
  id              Int            @id @default(autoincrement())
  semester        String?
  file            String?
  course          String?
  feeYearId       Int
  feeYear         FeeYear        @relation(fields: [feeYearId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  plannerCourse   PlannerCourse? @relation(fields: [plannerCourseId], references: [id])
  plannerCourseId Int?
  @@index([feeYearId])
}

model GalleryType {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  slug      String         @unique
  galleries PhotoGallery[]
  status    EStatus        @default(ENABLED)
  createdAt DateTime       @default(now())

  @@fulltext([name])
}

model PhotoGallery {
  id     Int         @id @default(autoincrement())
  typeId Int
  type   GalleryType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  image String?
  link  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LbefConnect {
  id        Int      @id @default(autoincrement())
  volume    String?
  duration  String?
  issue     String?
  image     String?
  file      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EDegree {
  MASTER
  BACHELOR
}

model Documents {
  id        Int      @id @default(autoincrement())
  document  String
  type      EDegree  @default(BACHELOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Journal {
  id        Int              @id @default(autoincrement())
  volume    String
  issue     String
  year      String
  month     String
  details   JournalDetails[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model JournalDetails {
  id              Int       @id @default(autoincrement())
  title           String?
  authors         String?
  pages           String?
  subject         String?
  country         String?
  pageNo          String?
  link            String?
  abstract        String?   @db.VarChar(1000)
  availableOnline DateTime?
  keywords        String?
  journal         Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  journalId       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@fulltext([title])
}

enum EStudyMode {
  MORNING
  DAY
  EVENING
  WEEKEND
}

enum EPrefix {
  MR
  MS
}

model AlumniForm {
  id               Int        @id @default(autoincrement())
  collegeRollNo    String     @unique
  uniRollNo        String     @unique
  prefix           EPrefix
  fullName         String
  degree           String
  yearOfPassing    String
  mode             EStudyMode
  email            String     @unique
  mobileNo         String
  presentEmployer  String?
  designation      String?
  content String?   @db.VarChar(1000)
  presentCountry   String?
  image            String?
  registrationDate DateTime   @default(now())
  status           EStatus    @default(ENABLED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  @@fulltext([collegeRollNo, uniRollNo, fullName, email])
}
 enum ESchlolarStatue{
  OPEN
  CLOSED
 }
model ScholarshipSchedule {
  id          Int      @id @default(autoincrement())
  scheduleYear       String   
  regisrationOpenDate       String   
  lastDate       String   
  canDate       String  
  admissionDate       String   
  status   ESchlolarStatue
  examDate   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
